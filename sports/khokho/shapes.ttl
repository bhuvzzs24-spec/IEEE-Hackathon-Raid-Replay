# =============================================================================
#  Kho-kho plugin for IPTC Sport Schema - SHACL shapes
#  Raid Replay / team Byte Tackle
#
#  Part 1 extends IPTC's *closed* shapes (same method as
#  kabaddi_plugin/kabaddi-shapes.ttl). Without it every kho-kho file is
#  rejected by IPTC's own shapes.
#
#  Part 2 adds kho-kho shapes and these simplified, documented rules:
#    * a tag gives the chasers points: touch 2, pole dive 2, sky dive 3
#    * no defender is tagged twice in a turn before their batch re-enters
#      (batches of 3: entry 1 = batch 1, 2 = batch 2, 3 = batch 3, 4 = batch 1 ...)
#    * every tag and every turn stays within the 420 s turn limit
#    * totals add up: turn points = its tags, team score = its chasing turns
#
#  As in the badminton pack, the rules run once per match (focus node = the
#  sport:Event) and name the offending action, which keeps pySHACL fast.
# =============================================================================

@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix sport:    <https://sportschema.org/ontologies/main/> .
@prefix kk:       <https://sportschema.org/ontologies/khokho/> .
@prefix kkmethod: <https://sportschema.org/ontologies/khokho/tagmethod/> .

# =============================================================================
#  PART 1 - extend IPTC's closed shapes (the "allowed properties" lists)
# =============================================================================

sport:ActionShape
  sh:property [ sh:path kk:nativeId ;            sh:datatype xsd:string ] ;
  sh:property [ sh:path kk:turnNumber ;          sh:datatype xsd:integer ] ;
  sh:property [ sh:path kk:inning ;              sh:datatype xsd:integer ] ;
  sh:property [ sh:path kk:chasingTeam ;         sh:class sport:Team ] ;
  sh:property [ sh:path kk:defendingTeam ;       sh:class sport:Team ] ;
  sh:property [ sh:path kk:tagger ;              sh:class sport:Athlete ] ;
  sh:property [ sh:path kk:taggedDefender ;      sh:class sport:Athlete ] ;
  sh:property [ sh:path kk:tagMethod ;           sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path kk:defenderBatch ;       sh:datatype xsd:integer ] ;
  sh:property [ sh:path kk:timeOfTag ;           sh:datatype xsd:integer ] ;
  sh:property [ sh:path kk:points ;              sh:datatype xsd:integer ] ;
  sh:property [ sh:path kk:turnDurationSeconds ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path kk:turnPoints ;          sh:datatype xsd:integer ] ;
  sh:property [ sh:path kk:tagCount ;            sh:datatype xsd:integer ] .

sport:EventShape
  sh:property [ sh:path kk:nativeId ;         sh:datatype xsd:string ] ;
  sh:property [ sh:path kk:turnLimitSeconds ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path kk:turnsPerMatch ;    sh:datatype xsd:integer ] ;
  sh:property [ sh:path kk:simulatorSeed ;    sh:datatype xsd:integer ] .

sport:TeamShape
  sh:property [ sh:path kk:nativeId ;  sh:datatype xsd:string ] ;
  sh:property [ sh:path kk:shortName ; sh:datatype xsd:string ] .

sport:AthleteShape
  sh:property [ sh:path kk:nativeId ; sh:datatype xsd:string ] .

sport:SiteShape
  sh:property [ sh:path kk:nativeId ; sh:datatype xsd:string ] .

sport:IndividualParticipationShape
  sh:property [ sh:path kk:defenderBatch ; sh:datatype xsd:integer ; sh:in ( 1 2 3 ) ; sh:maxCount 1 ] .

# =============================================================================
#  PART 2 - kho-kho shapes
# =============================================================================

kk:KhokhoActionShape
  a sh:NodeShape ;
  sh:targetClass kk:TurnStart, kk:Tag, kk:TurnEnd, kk:Turn ;
  sh:property [ sh:path kk:nativeId ;          sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path sport:sequenceNumber ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[1-9][0-9]*$" ] ;
  sh:property [ sh:path sport:actionInEvent ;  sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path kk:turnNumber ;        sh:minCount 1 ; sh:maxCount 1 ; sh:in ( 1 2 3 4 ) ;
                sh:message "A match has 4 turns: turn number must be 1-4." ] .

kk:TurnStartShape
  a sh:NodeShape ;
  sh:targetClass kk:TurnStart ;
  sh:property [ sh:path kk:inning ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( 1 2 ) ] .

kk:TagShape
  a sh:NodeShape ;
  sh:targetClass kk:Tag ;
  sh:property [ sh:path kk:tagger ;         sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path kk:taggedDefender ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path kk:tagMethod ;      sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( kkmethod:touch kkmethod:pole-dive kkmethod:sky-dive ) ;
                sh:message "Tag method must be touch, pole dive or sky dive." ] ;
  sh:property [ sh:path kk:defenderBatch ;  sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path kk:timeOfTag ;      sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path kk:points ;         sh:minCount 1 ; sh:maxCount 1 ; sh:in ( 2 3 ) ] .

kk:TurnEndShape
  a sh:NodeShape ;
  sh:targetClass kk:TurnEnd ;
  sh:property [ sh:path kk:turnDurationSeconds ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] .

kk:TurnShape
  a sh:NodeShape ;
  sh:targetClass kk:Turn ;
  sh:property [ sh:path kk:chasingTeam ;   sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path kk:defendingTeam ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path kk:turnPoints ;    sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path kk:tagCount ;      sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] .

# ---- the match and the rules ------------------------------------------------------
kk:KhokhoMatchShape
  a sh:NodeShape ;
  sh:targetSubjectsOf kk:turnLimitSeconds ;
  sh:property [ sh:path sport:sport ; sh:hasValue <http://cv.iptc.org/newscodes/mediatopic/15000000> ;
                sh:message "IPTC has no kho-kho topic: a kho-kho match declares the generic sport topic medtop:15000000." ] ;
  sh:property [ sh:path kk:nativeId ;         sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path kk:turnLimitSeconds ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( 420 ) ] ;
  sh:property [ sh:path kk:turnsPerMatch ;    sh:minCount 1 ; sh:maxCount 1 ; sh:in ( 4 ) ] ;
  sh:property [ sh:path sport:participation ; sh:minCount 2 ; sh:maxCount 2 ] ;

  sh:sparql [
    sh:message "Tag points must match the method (touch 2, pole dive 2, sky dive 3): {?x}" ;
    sh:select """
      PREFIX sport: <https://sportschema.org/ontologies/main/>
      PREFIX kk: <https://sportschema.org/ontologies/khokho/>
      PREFIX kkmethod: <https://sportschema.org/ontologies/khokho/tagmethod/>
      SELECT $this ?x WHERE {
        ?x sport:actionInEvent $this ; kk:tagMethod ?m ; kk:points ?p .
        FILTER (?p != IF(?m = kkmethod:sky-dive, 3, 2))
      }""" ] ;
  sh:sparql [
    sh:message "Turn totals don't add up: kk:turnPoints / kk:tagCount must equal the turn's tags: {?x}" ;
    sh:select """
      PREFIX sport: <https://sportschema.org/ontologies/main/>
      PREFIX kk: <https://sportschema.org/ontologies/khokho/>
      SELECT $this ?x WHERE {
        ?x sport:actionInEvent $this ; a kk:Turn ; kk:turnNumber ?n ; kk:turnPoints ?tp ; kk:tagCount ?tc .
        OPTIONAL { ?tag sport:actionInEvent $this ; a kk:Tag ; kk:turnNumber ?n ; kk:points ?p . }
      } GROUP BY $this ?x ?tp ?tc
        HAVING (COALESCE(SUM(?p), 0) != ?tp || COUNT(?tag) != ?tc)""" ] ;
  sh:sparql [
    sh:message "Each team's sport:score must equal the points it scored as chasers: {?tp}" ;
    sh:select """
      PREFIX sport: <https://sportschema.org/ontologies/main/>
      PREFIX kk: <https://sportschema.org/ontologies/khokho/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT $this ?tp WHERE {
        $this sport:participation ?tp . ?tp sport:score ?sc ; sport:participationBy ?team .
        OPTIONAL { ?t sport:actionInEvent $this ; a kk:Turn ; kk:chasingTeam ?team ; kk:turnPoints ?p . }
      } GROUP BY $this ?tp ?sc HAVING (COALESCE(SUM(?p), 0) != xsd:integer(?sc))""" ] ;
  sh:sparql [
    sh:message "Outside the turn time limit (tag later than the limit or than the turn's end): {?x}" ;
    sh:select """
      PREFIX sport: <https://sportschema.org/ontologies/main/>
      PREFIX kk: <https://sportschema.org/ontologies/khokho/>
      SELECT $this ?x WHERE {
        $this kk:turnLimitSeconds ?lim .
        { ?x sport:actionInEvent $this ; kk:turnDurationSeconds ?d . FILTER (?d > ?lim) }
        UNION
        { ?x sport:actionInEvent $this ; kk:turnNumber ?n ; kk:timeOfTag ?t .
          OPTIONAL { ?end sport:actionInEvent $this ; kk:turnNumber ?n ; kk:turnDurationSeconds ?d2 . }
          FILTER (?t > ?lim || (BOUND(?d2) && ?t > ?d2)) }
      }""" ] ;
  sh:sparql [
    sh:message "Tag times must not go backwards within a turn: {?x}" ;
    sh:select """
      PREFIX sport: <https://sportschema.org/ontologies/main/>
      PREFIX kk: <https://sportschema.org/ontologies/khokho/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT $this ?x WHERE {
        ?x sport:actionInEvent $this ; kk:turnNumber ?n ; kk:timeOfTag ?t ; sport:sequenceNumber ?s .
        ?y sport:actionInEvent $this ; kk:turnNumber ?n ; kk:timeOfTag ?t2 ; sport:sequenceNumber ?s2 .
        FILTER (xsd:integer(?s2) < xsd:integer(?s) && ?t2 > ?t)
      }""" ] ;
  sh:sparql [
    sh:message "Defender tagged twice in the same turn before their batch re-entered: {?x}" ;
    sh:select """
      PREFIX sport: <https://sportschema.org/ontologies/main/>
      PREFIX kk: <https://sportschema.org/ontologies/khokho/>
      SELECT $this ?x WHERE {
        ?x sport:actionInEvent $this ; a kk:Tag ; kk:turnNumber ?n ; kk:defenderBatch ?e ; kk:taggedDefender ?d .
        ?y sport:actionInEvent $this ; a kk:Tag ; kk:turnNumber ?n ; kk:defenderBatch ?e ; kk:taggedDefender ?d .
        FILTER (?x != ?y)
      }""" ] ;
  sh:sparql [
    sh:message "A batch has 3 defenders: at most 3 tags per batch entry, and entry k starts only after entry k-1 lost all 3: {?x}" ;
    sh:select """
      PREFIX sport: <https://sportschema.org/ontologies/main/>
      PREFIX kk: <https://sportschema.org/ontologies/khokho/>
      SELECT $this ?x WHERE {
        ?x sport:actionInEvent $this ; a kk:Tag ; kk:turnNumber ?n ; kk:defenderBatch ?e .
        BIND (?e - 1 AS ?pe)
        OPTIONAL { ?y sport:actionInEvent $this ; a kk:Tag ; kk:turnNumber ?n ; kk:defenderBatch ?e . }
        OPTIONAL { ?z sport:actionInEvent $this ; a kk:Tag ; kk:turnNumber ?n ; kk:defenderBatch ?pe . }
      } GROUP BY $this ?x ?e
        HAVING (COUNT(DISTINCT ?y) > 3 || (?e > 1 && COUNT(DISTINCT ?z) != 3))""" ] ;
  sh:sparql [
    sh:message "The tagged defender must belong to the batch on the field (entry 1, 4, 7 = batch 1; 2, 5 = batch 2; 3, 6 = batch 3): {?x}" ;
    sh:select """
      PREFIX sport: <https://sportschema.org/ontologies/main/>
      PREFIX kk: <https://sportschema.org/ontologies/khokho/>
      SELECT $this ?x WHERE {
        ?x sport:actionInEvent $this ; a kk:Tag ; kk:defenderBatch ?e ; kk:taggedDefender ?d .
        OPTIONAL { ?ip sport:participationBy ?d ; kk:defenderBatch ?b . }
        FILTER (!BOUND(?b) || ?b != ?e - 3 * FLOOR((?e - 1) / 3))
      }""" ] ;
  sh:sparql [
    sh:message "The tagger must be on the chasing team and the defender on the defending team: {?x}" ;
    sh:select """
      PREFIX sport: <https://sportschema.org/ontologies/main/>
      PREFIX kk: <https://sportschema.org/ontologies/khokho/>
      SELECT $this ?x WHERE {
        ?x sport:actionInEvent $this ; a kk:Tag ; kk:turnNumber ?n ; kk:tagger ?c ; kk:taggedDefender ?d .
        ?t sport:actionInEvent $this ; a kk:Turn ; kk:turnNumber ?n ; kk:chasingTeam ?ct ; kk:defendingTeam ?dt .
        ?ipc sport:participationBy ?c ; sport:teamParticipation/sport:participationBy ?cteam .
        ?ipd sport:participationBy ?d ; sport:teamParticipation/sport:participationBy ?dteam .
        FILTER (?cteam != ?ct || ?dteam != ?dt)
      }""" ] ;
  sh:sparql [
    sh:message "Turns alternate: one Turn record per turn, chasing team != defending team, each team chases twice: {?x}" ;
    sh:select """
      PREFIX sport: <https://sportschema.org/ontologies/main/>
      PREFIX kk: <https://sportschema.org/ontologies/khokho/>
      SELECT $this ?x WHERE {
        { ?x sport:actionInEvent $this ; a kk:Turn ; kk:chasingTeam ?c ; kk:defendingTeam ?c . }
        UNION
        { ?x sport:actionInEvent $this ; a kk:Turn ; kk:turnNumber ?n .
          ?y sport:actionInEvent $this ; a kk:Turn ; kk:turnNumber ?n . FILTER (?x != ?y) }
        UNION
        { SELECT $this ?x WHERE {
            $this sport:participation/sport:participationBy ?x .
            OPTIONAL { ?t sport:actionInEvent $this ; a kk:Turn ; kk:chasingTeam ?x . }
          } GROUP BY $this ?x HAVING (COUNT(?t) != 2) }
      }""" ] ;
  sh:sparql [
    sh:message "Result must follow the scores: higher score wins, equal scores tie: {?t1}" ;
    sh:select """
      PREFIX sport: <https://sportschema.org/ontologies/main/>
      PREFIX speventoutcome: <http://cv.iptc.org/newscodes/speventoutcome/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT $this ?t1 WHERE {
        $this sport:participation ?t1, ?t2 . FILTER (?t1 != ?t2)
        ?t1 sport:score ?s1 ; sport:eventOutcome ?o . ?t2 sport:score ?s2 .
        BIND (xsd:integer(?s1) AS ?a) BIND (xsd:integer(?s2) AS ?b)
        FILTER ( (?o = speventoutcome:win && ?a <= ?b) || (?o = speventoutcome:loss && ?a >= ?b)
              || (?o = speventoutcome:tie && ?a != ?b) )
      }""" ] .
